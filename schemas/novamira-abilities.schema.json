{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elconv/novamira-abilities/v1",
  "title": "Novamira ability registry snapshot",
  "description": "Consolidated, versioned snapshot of the Novamira MCP ability registry: every known ability name (enum), the legacy-name alias map, documented unavailable gaps and per-namespace counts. Derived from KNOWN_ABILITIES in @elconv/mcp; see docs/NOVAMIRA-LIVE-ABILITIES-2026-07-30.txt.",
  "version": "v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "$schema": {
      "const": "elconv/novamira-abilities/v1"
    },
    "knownAbilities": {
      "type": "array",
      "description": "Every ability the live Novamira server exposes.",
      "items": {
        "$ref": "#/$defs/abilityName"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "aliases": {
      "type": "object",
      "description": "Legacy ability names mapped onto live ones (ALIAS_MAP).",
      "additionalProperties": {
        "$ref": "#/$defs/abilityName"
      }
    },
    "unavailableAbilities": {
      "type": "object",
      "description": "Names referenced on purpose but not live (documented gaps).",
      "additionalProperties": {
        "type": "string"
      }
    },
    "namespaceCounts": {
      "type": "object",
      "description": "Per-namespace known-ability counts (deterministic, sorted).",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "schemaVersion",
    "$schema",
    "knownAbilities",
    "aliases",
    "unavailableAbilities"
  ],
