{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elconv/wizard-contract/v1",
  "title": "elconv wizard contract",
  "description": "Consolidated, versioned machine-readable contract for a wizard run: per-phase statuses, exit codes, forwarded build/QA options, build-option parity and artifact paths.",
  "version": "v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "$schema": {
      "type": "string",
      "const": "elconv/wizard-contract/v1"
    },
    "target": {
      "type": "string",
      "enum": [
        "v3",
        "v4"
      ]
    },
    "dryRun": {
      "type": "boolean"
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "preflight",
              "extract",
              "build",
              "validate",
              "deploy",
              "qa",
              "done"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "skipped",
              "pending",
              "unavailable"
            ]
          },
          "error": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "status",
          "artifacts"
        ],
        "additionalProperties": false
      }
    },
    "optionsForwarded": {
      "type": "object",
      "properties": {
        "viewports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 320,
            "maximum": 3840
          }
        },
        "strictness": {
          "type": "string",
          "enum": [
            "draft",
            "balanced",
            "pixel-perfect"
          ]
        },
        "animations": {
          "type": "string",
          "enum": [
            "none",
            "css",
            "gsap",
            "auto"
          ]
        },
        "fonts": {
          "type": "string",
          "enum": [
            "auto",
            "system",
            "all"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tokenStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "preserve",
            "inline",
            "global"
          ]
        },
        "responsiveStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "preserve",
            "mobile-first"
          ]
        },
        "unknownWidgetStrategy": {
          "type": "string",
          "enum": [
            "fallback-html",
            "skip",
            "error"
          ]
        },
        "aiMode": {
          "type": "string",
          "enum": [
            "deterministic",
            "fallback",
            "required"
          ]
        },
        "qa": {
          "type": "object",
          "properties": {
            "referenceUrl": {
              "type": "string"
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "maxRepairRounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "autoFix": {
              "type": "boolean"
            },
            "heal": {
              "type": "boolean"
            },
            "fullContextRepair": {
              "type": "boolean"
            }
          },
          "required": [
            "threshold",
            "maxRepairRounds",
            "autoFix",
            "heal",
            "fullContextRepair"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "viewports",
        "strictness",
        "animations",
        "fonts",
        "sections",
        "qa"
      ],
      "additionalProperties": false
    },
    "optionsAppliedToBuild": {
      "type": "object",
      "properties": {
        "strictness": {
          "type": "string",
          "enum": [
            "draft",
            "balanced",
            "pixel-perfect"
          ]
        },
        "animations": {
          "type": "string",
          "enum": [
            "none",
            "css",
            "gsap",
            "auto"
          ]
        },
        "fonts": {
          "type": "string",
          "enum": [
            "auto",
            "system",
            "all"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aiMode": {
          "type": "string",
          "enum": [
            "deterministic",
            "fallback",
            "required"
          ]
        }
      },
      "required": [
        "strictness",
        "animations",
        "fonts",
        "sections"
      ],
      "additionalProperties": false
    },
    "artifactPaths": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "remoteState": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "configured"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "$schema",
    "target",
    "dryRun",
    "exitCode",
    "phases",
    "optionsForwarded",
    "optionsAppliedToBuild",
    "artifactPaths",
    "remoteState"
  ],
  "additionalProperties": false
}
